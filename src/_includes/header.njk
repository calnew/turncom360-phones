<header class="header">
  <nav class="nav" aria-label="Main navigation">

    <a href="/" class="logo" aria-label="TurnCom360 — Plug &amp; Play Phone Systems home">
      <img src="https://lirp.cdn-website.com/e00c4765/dms3rep/multi/opt/Original-fdd5cb7a-1920w.png"
           alt="TurnCom360"
           width="132" height="44"
           loading="eager">
    </a>

    <button class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="navLinks">
      <span aria-hidden="true">&#9776;</span>
    </button>

    <ul class="nav-links" id="navLinks" role="menubar">
      {%- for item in site.nav_main %}
      <li role="none">
        <a href="{{ item.url }}"
           role="menuitem"
           {% if item.is_cta %}class="nav-cta"{% endif %}
           {% if item.external %}target="_blank" rel="noopener"{% endif %}
           {% if page.url == item.url %}aria-current="page"{% endif %}>
          {{ item.label }}
        </a>
      </li>
      {%- endfor %}
    </ul>

  </nav>
</header>
